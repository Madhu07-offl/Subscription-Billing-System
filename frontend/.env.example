# Copy to .env for local development. Vite reads VITE_* variables at build time; never put secrets here.

# Base URL of the backend API (the FastAPI app runs on port 8000 locally). On Render, set this to the deployed API,
# e.g. https://subscription-billing-api.onrender.com/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Set to true to run on in-memory demo data with no backend (offline demos). Leave unset for the real API.
# VITE_USE_MOCK=true
