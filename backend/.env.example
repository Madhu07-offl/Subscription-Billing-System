# Copy to backend/.env and fill in. Never commit .env.

# SQLAlchemy/psycopg URL. Supabase: Project Settings -> Database -> Connection string.
# Plain postgresql:// is accepted; the app rewrites it to postgresql+psycopg://.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Long random string used to sign JWTs, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Optional (defaults shown)
# JWT_EXPIRES_SECONDS=28800
# RESET_TOKEN_MINUTES=30
# FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
