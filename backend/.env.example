# Copy to backend/.env and fill in. Never commit .env.

# SQLAlchemy/psycopg URL. Supabase: Project Settings -> Database -> Connection string.
# Plain postgresql:// is accepted; the app rewrites it to postgresql+psycopg://.
# On Render (IPv4 only) use the Supabase *pooler* string (Connect -> Transaction pooler, host ...pooler.supabase.com).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Long random string used to sign JWTs, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Optional (defaults shown)
# JWT_EXPIRES_SECONDS=28800
# RESET_TOKEN_MINUTES=30
# Base URL of the frontend (used in the password-reset link that is logged until email sending exists)
# FRONTEND_URL=http://localhost:5173
# Browser origins allowed to call the API (CORS), comma separated, no trailing slash. Set this to the deployed
# frontend, e.g. https://billing.example.com. The old name CORS_ORIGINS still works when this is unset.
# FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
